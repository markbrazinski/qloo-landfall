# Names only. Copy to .env and fill in privately; never commit .env.
# Copying or filling these in does not authorize live calls.
AWS_PROFILE=landfall
qloo_server=
api_key=
api_docs=
# Optional (BUILD-PLAN §5): replay accepted case dirs (comma-separated) and let only these stages go live, e.g.
# identity,profile,profile_edit. LANDFALL_REPLAY_DELAY paces replayed pages/model calls in seconds.
LANDFALL_REPLAY_CASES=
LANDFALL_LIVE_STAGES=
LANDFALL_REPLAY_DELAY=
# Slice 4.5 (BUILD-PLAN §4.5.9a, §4.5.13). Owner setup: scripts/cloudshell/. Early checks: scripts/early_access.py.
# LANDFALL_ENV=dev|judging (only judging may spend a provider's judging reserve).
LANDFALL_ENV=
# Unset until slice 8 serves Landfall's own agent profile; unset means products come from the brand's pages.
SHOPIFY_AGENT_PROFILE_URL=
youtube_api_key=
google_oauth_client_id=
google_oauth_client_secret=
gmail_test_recipient=
meta_access_token=
meta_ad_account_id=
meta_graph_version=
# Slice 6 delivery (BUILD-PLAN "Slice 6 · Delivery"). Unset = "Direct delivery unavailable in this deployment"; exports still work.
# LANDFALL_TOKEN_KEY: a Fernet key that encrypts connection tokens. LANDFALL_PUBLIC_URL: base of the OAuth callback
# (<url>/api/connections/callback). LANDFALL_DELIVERY_ALLOWLIST: comma-separated addresses and account ids a live write may
# reach (empty refuses every live write; * only in production).
LANDFALL_TOKEN_KEY=
# The slice-6 copy writer and check (default Nova Pro); everything else uses LANDFALL_NOVA_MODEL.
LANDFALL_COPY_MODEL=
LANDFALL_PUBLIC_URL=
LANDFALL_DELIVERY_ALLOWLIST=
# Slice 6.7 test delivery: test_redirect (default) sends only from gmail_test_sender (must be the connected Gmail)
# to gmail_test_recipient; the partner is shown, never contacted. "direct" is refused when LANDFALL_ENV=judging.
LANDFALL_EMAIL_MODE=
gmail_test_sender=
# Owner-recorded platform access: GMAIL TESTING|PENDING|VERIFIED; META APP_ROLES|PENDING|ADVANCED;
# GOOGLE_ADS TEST|PENDING|EXPLORER|BASIC|STANDARD (unset = API not enabled); TIKTOK PENDING|APPROVED.
LANDFALL_GMAIL_ACCESS=
LANDFALL_META_ACCESS=
LANDFALL_GOOGLE_ADS_ACCESS=
LANDFALL_TIKTOK_ACCESS=
meta_app_id=
meta_app_secret=
meta_login_config_id=
tiktok_app_id=
tiktok_app_secret=
# Slice 6.6 creator discovery (BUILD-PLAN "Slice 6.6"). Unset = "Creator discovery isn't connected". Hosted: SSM
# /landfall/judging/influencers_club_api_key. Server-only; never in browser code, logs, captures or exports.
influencers_club_api_key=
# Mockup scenes (BUILD-PLAN UI.13): a Google AI Studio key selects gemini-nano-banana-2.1; unset = Stability on Bedrock.
gemini_api_key=
# Slice 6.7 locked test destinations (S4, S5; T1 only once TikTok grants access). LANDFALL_GOOGLE_ADS_ACCESS=TEST uses only
# google_ads_test_customer_id, read through google_ads_test_manager_id. LANDFALL_META_ACCESS=SANDBOX uses only
# meta_ad_account_id (act_<digits>). LANDFALL_TIKTOK_ACCESS=SANDBOX uses the portal-issued token. Put each id on the allow-list.
google_ads_test_manager_id=
google_ads_test_customer_id=
tiktok_sandbox_token=
tiktok_sandbox_advertiser_id=
tiktok_sandbox_location_id=
# Owner-connected shared delivery for judges (BUILD-PLAN G-J): "on" lets projects without their own connection use the
# owner's con__shared_EMAIL (TEST_REDIRECT only) and con__shared_GOOGLE_ADS (TEST access only). Connect with
# `make owner-connect DST=EMAIL|GOOGLE_ADS`. Allowance defaults: 20 total and 2 per project for each destination.
LANDFALL_SHARED_DELIVERY=
LANDFALL_SHARED_EMAIL_TOTAL=
LANDFALL_SHARED_EMAIL_PER_PROJECT=
LANDFALL_SHARED_GOOGLE_ADS_TOTAL=
LANDFALL_SHARED_GOOGLE_ADS_PER_PROJECT=
# A1 access tracks (owner, 27 Oct 2026): "on" = only a judge/owner link session researches live; everyone else gets the
# recorded demo. Unset = all live (local development). Links: make access-create / access-list / access-revoke.
LANDFALL_REQUIRE_GRANT=
