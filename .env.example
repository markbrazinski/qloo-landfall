# Copy to .env and fill in what you use. .env is gitignored; never commit it. Lines starting "# NAME=" have defaults:
# uncomment one to override it.
# `make replay` and `make test` need none of this. `make dev` (live research) needs the first two groups.

# --- Amazon Bedrock (Nova models). Unset AWS_PROFILE uses boto3's normal credential chain.
# AWS_PROFILE=
AWS_REGION=us-east-1
# Model ids; the defaults are Nova 2 Lite for reading and research, Nova Pro for ad copy and its check.
# LANDFALL_NOVA_MODEL=
# LANDFALL_COPY_MODEL=

# --- Qloo Insights API
qloo_server=
api_key=

# --- Spending caps (checked before every paid call). Defaults: US$75 Bedrock, 2,500 Qloo requests, 3,000 page
# fetches, US$15 Gemini images; live research stops at the Qloo floor (1,000 requests left). Optional end date (ISO 8601).
# LANDFALL_CAP_USD=
# LANDFALL_CAP_QLOO=
# LANDFALL_CAP_FETCH=
# LANDFALL_CAP_GEMINI_USD=
# LANDFALL_QLOO_FLOOR=
# LANDFALL_AUTHORITY_EXPIRES=

# --- Optional providers
# Ad and shelf mockup images: a Google AI Studio key uses Gemini; unset uses Stability on Bedrock.
gemini_api_key=
# Creator discovery (Influencers.club). Server-side only. A local key gets 10 requests / 4 credits in total.
influencers_club_api_key=
LANDFALL_IC_TERMS_V24_CONFIRMED=
# YouTube channel lookups for creators (both needed).
LANDFALL_ENABLE_YOUTUBE=
youtube_api_key=
# A Shopify agent profile URL to read products from; unset reads them from the brand's own pages and feed.
SHOPIFY_AGENT_PROFILE_URL=

# --- Delivery (sending approved emails and creating paused ads). Unset: direct delivery is unavailable; exports still work.
# LANDFALL_TOKEN_KEY: a Fernet key that encrypts connection tokens. LANDFALL_PUBLIC_URL: the app's base URL, used for the
# OAuth callback (<url>/api/connections/callback). LANDFALL_DELIVERY_ALLOWLIST: comma-separated addresses and account ids
# a live write may reach (empty refuses every live write).
LANDFALL_TOKEN_KEY=
LANDFALL_PUBLIC_URL=
LANDFALL_DELIVERY_ALLOWLIST=
google_oauth_client_id=
google_oauth_client_secret=
# Gmail: test_redirect (default) sends only from gmail_test_sender (the connected Gmail) to gmail_test_recipient.
LANDFALL_EMAIL_MODE=
gmail_test_sender=
gmail_test_recipient=
# Platform access levels: GMAIL TESTING|PENDING|VERIFIED; META APP_ROLES|PENDING|ADVANCED|SANDBOX;
# GOOGLE_ADS TEST|PENDING|EXPLORER|BASIC|STANDARD (unset = not enabled); TIKTOK PENDING|APPROVED|SANDBOX.
LANDFALL_GMAIL_ACCESS=
LANDFALL_META_ACCESS=
LANDFALL_GOOGLE_ADS_ACCESS=
LANDFALL_TIKTOK_ACCESS=
# Google Ads TEST access reads this test customer through its manager account.
google_ads_test_manager_id=
google_ads_test_customer_id=
meta_app_id=
meta_app_secret=
meta_login_config_id=
meta_ad_account_id=
meta_graph_version=
tiktok_app_id=
tiktok_app_secret=
tiktok_sandbox_token=
tiktok_sandbox_advertiser_id=
tiktok_sandbox_location_id=

# --- Hosting. LANDFALL_REQUIRE_GRANT=on: only browsers holding an access link research live; others get the recorded
# runs. LANDFALL_ENV=judging marks a hosted deployment. LANDFALL_SHARED_DELIVERY=on lets projects without their own
# connection use the operator's shared Gmail and Google Ads test connections, within LANDFALL_SHARED_<EMAIL|GOOGLE_ADS>_TOTAL
# and _PER_PROJECT (defaults 20 and 2).
LANDFALL_REQUIRE_GRANT=
LANDFALL_ENV=
LANDFALL_SHARED_DELIVERY=
LANDFALL_SHARED_EMAIL_TOTAL=
LANDFALL_SHARED_EMAIL_PER_PROJECT=
LANDFALL_SHARED_GOOGLE_ADS_TOTAL=
LANDFALL_SHARED_GOOGLE_ADS_PER_PROJECT=
