# Names only. Copy to .env and fill in privately; never commit .env.
# Copying or filling these in does not authorize live calls.
AWS_PROFILE=landfall
qloo_server=
api_key=
api_docs=
# Optional (BUILD-PLAN §5): replay accepted case dirs (comma-separated) and let only these stages go live, e.g.
# identity,profile,profile_edit. LANDFALL_REPLAY_DELAY paces replayed pages/model calls in seconds.
LANDFALL_REPLAY_CASES=
LANDFALL_LIVE_STAGES=
LANDFALL_REPLAY_DELAY=
