# Landfall origin proxy. CloudFront terminates HTTPS and adds X-Origin-Verify; the security group admits only CloudFront.
# ORIGIN_SECRET comes from /etc/caddy/landfall.env (SSM). Public since the judge release (29 Oct 2026): visitors get the
# recorded demo; only a judge link's session runs live (LANDFALL_REQUIRE_GRANT=on, landfall/grants.py).
{
	admin off
	auto_https off
}

:80 {
	header {
		Referrer-Policy no-referrer
		X-Robots-Tag noindex
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	route {
		@stranger not header X-Origin-Verify {$ORIGIN_SECRET}
		respond @stranger 403

		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle_errors {
		root * /srv/landfall/www
		rewrite * /starting.html
		file_server {
			status 503
		}
	}
}
